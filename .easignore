# What `eas build` leaves out when it packs the project for upload (docs/release.md).
# EAS CLI reads this file instead of .gitignore, not on top of it, so every .gitignore rule
# is repeated here; src/__tests__/easIgnore.test.ts keeps the two in step.

# --- the same as .gitignore ---

# dependencies
node_modules/

# Expo
.expo/
dist/
dist-web/
web-build/
expo-env.d.ts

# Native
*.orig.*
*.jks
*.p8
*.p12
*.key
*.mobileprovision

# Metro
.metro-health-check*

# debug
npm-debug.*
yarn-debug.*
yarn-error.*

# macOS
.DS_Store
*.pem

# local env files
.env*.local

# typescript
*.tsbuildinfo

app-example

# Native (generated by EAS / expo prebuild)
/android
/ios

# tests
coverage/

# --- only for the upload: the build never reads these ---

# The shallow Git copy that EAS CLI adds to the archive. It holds every file of the commit
# a second time, the original art included.
.git

# The original WorkoutTitan art. The app takes the converted copies in assets/scene.
/assets/AppAssets

# The pictures and texts for the Google Play page.
/store
